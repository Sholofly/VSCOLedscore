WS_URL=wss://wss.ledscores.score.tel/clubs/vsco61/
WS_TOKEN=
REGULAR_MINUTES=90

# Webomgeving (verplicht voor Docker): inloggen met deze gegevens.
WEB_USER=admin
WEB_PASSWORD=
# Optioneel: tweede login die alleen berichten deelt (leeg wachtwoord = uit).
# SHARE_USER=gebruiker
# SHARE_PASSWORD=
# Zo lang blijf je ingelogd in de webomgeving (1-365 dagen):
# SESSION_DAYS=30
# Contactadres voor pushmeldingen (alleen de pushdiensten zien het): mailto:... of https://domein
# VAPID_SUBJECT=https://github.com
# HOST_PORT=8080
# Bereikbaar vanaf je netwerk (bv. op een NAS) in plaats van alleen vanaf de machine zelf:
# BIND_ADDRESS=0.0.0.0

# Alleen voor deployen met de kant-en-klare image van GitHub (zie README):
# IMAGE=ghcr.io/<jouwnaam>/<repo>:latest

# Uitwedstrijden via tikkieterug (openbare API, geen sleutel nodig):
# TIKKIETERUG_URL=https://tikkieterug.sholofly.nl
